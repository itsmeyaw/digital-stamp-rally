# --- Runtime (required in production) ---

# Postgres connection string. On Vercel use a pooled/serverless-friendly URL
# (e.g. Supabase pooler or Neon). The DB client uses max=1, prepare=false.
DATABASE_URL=postgres://user:password@localhost:5432/digital_stamp_rally

# Secret used to sign session tokens (HMAC-SHA256). Use a long random value.
SESSION_SECRET=replace-with-a-long-random-secret

# --- Deploy config ---

# Event name shown on the welcome screen ("Welcome to {EVENT_NAME} Stamp Rally").
EVENT_NAME=Demo Day

# Optional: session lifetime in seconds. Defaults to 30 days.
# SESSION_TTL_SECONDS=2592000

# --- Tests ---
# Optional: if set, the test harness creates ephemeral databases on this
# Postgres server (closest to production). If unset, the harness falls back to
# in-process PGlite (no Docker, no server needed). Point this at a
# Testcontainers Postgres URI to use Testcontainers.
# DATABASE_URL_TEST=postgres://user:password@localhost:5432/postgres
